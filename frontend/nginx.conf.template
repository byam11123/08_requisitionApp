server {
    listen 80;
    server_name localhost;
    
    # Increase upload size limit to 50MB
    client_max_body_size 50M;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Proxy API calls to backend using the PUBLIC URL from environment variable
    # This solves the "host not found" internal DNS issue
    location /api/ {
        # ${VITE_API_URL} will be replaced by the actual URL https://... at existing container startup
        proxy_pass ${VITE_API_URL}/api/;
        
        # When proxying to a public HTTPS URL:
        proxy_ssl_server_name on; 
        proxy_set_header Host $proxy_host; # Vital for Render shared load balancers
        
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
